# Build and tooling
node_modules/
out/
*.log
.vercel
.claude/

# Working material, not the product. The reference reports, sample bills,
# letterhead artwork, logos and the downloaded vendor copies live beside the
# repository in _material/ - they are what the tool was BUILT from, not part
# of what it ships, and 148 MB of them in git made every clone a download
# nobody wanted. Nothing here is lost; it is next to the code, ignored.
_material/
_to_delete/
patches/
sample bills/
sample reports/
report design/
logos/
vendor/

# Superseded: the offline launcher, the double-clickable duplicate of
# index.html, and the push notes for a push that has happened.
serve.js
PostMan.html
PUSH.md
APPLY.md
*.cmd
*.zip

# The development database and any .env - the server keeps its own on the box.
server/*.db
server/*.db-shm
server/*.db-wal
server/.env
__pycache__/
*.pyc

# A local run of the API keeps its data here when DATA_DIR points at the repo.
server/_devdata/

# The team list with real passwords. The usernames are in
# team.example.json; the passwords stay on the server.
server/team.json
