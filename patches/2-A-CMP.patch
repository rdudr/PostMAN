From 191f6b74f262f73fe1caf247e532faa6ab33cbbb Mon Sep 17 00:00:00 2001
From: Rishabh <iea@iitgn.ac.in>
Date: Wed, 23 Sep 2026 05:54:30 +0000
Subject: [PATCH] Send to PostMan works in its panel, not only in a window

PostMan now opens this app embedded in its own page as well as in a
separate window. Framed, there is no window.opener - the parent IS PostMan
- so checking only opener meant the panel could show the app and then
silently refuse to send. postmanWindow() takes whichever exists.

greetPostman() posts a hello on mount. Nothing cross-origin lets a parent
tell an embedded frame that rendered from the browser's own 'refused to
connect' page, so PostMan hedges its wording until the app says it is
there. Ignored when opened in a window.

Pairs with rdudr/PostMAN.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01Xm4qAQ9BCEZr2WURqzV9Vo
---
 app/(console)/report/page.tsx |  6 ++++--
 lib/postman-handoff.ts        | 38 ++++++++++++++++++++++++++---------
 2 files changed, 33 insertions(+), 11 deletions(-)

diff --git a/app/(console)/report/page.tsx b/app/(console)/report/page.tsx
index 1e16eb0..4a8f962 100644
--- a/app/(console)/report/page.tsx
+++ b/app/(console)/report/page.tsx
@@ -19,7 +19,7 @@ import {
   exportCompressorsExcel, shareCompressorsExcel, mergeCompressorsFromWorkbook, readWorkbookFile,
   buildExcelBase64, ACMP_FORMAT,
 } from "@/lib/compressor-excel";
-import { captureHandoff, sendToPostman, type PostmanHandoff } from "@/lib/postman-handoff";
+import { captureHandoff, sendToPostman, greetPostman, type PostmanHandoff } from "@/lib/postman-handoff";
 
 export default function ReportPage() {
   const profile = useAppStore((s) => s.profile);
@@ -47,7 +47,9 @@ export default function ReportPage() {
 
   /* Did PostMan open us? Only then is there anywhere to send to. */
   useEffect(() => {
-    setHandoff(captureHandoff());
+    const h = captureHandoff();
+    setHandoff(h);
+    if (h) greetPostman();   /* so PostMan's panel knows we rendered */
   }, []);
 
   useEffect(() => {
diff --git a/lib/postman-handoff.ts b/lib/postman-handoff.ts
index 28665d4..6e438b1 100644
--- a/lib/postman-handoff.ts
+++ b/lib/postman-handoff.ts
@@ -89,12 +89,23 @@ export function getHandoff(): PostmanHandoff | null {
   }
 }
 
-/* True when there is a PostMan to send to AND a window to send through.
-   `window.opener` is null if the tab was reloaded from history or opened
-   by hand, in which case the button should not be offered at all. */
+/* The window to post back to.
+
+   PostMan opens this app two ways: in a panel inside its own page, and in a
+   separate window. Framed there is no `opener` and the parent is PostMan;
+   in a window there is an `opener` and `parent` is this window itself.
+   Checking only `opener` - which is what this did first - meant the
+   embedded panel could show the app and then silently refuse to send. */
+function postmanWindow(): Window | null {
+  if (typeof window === "undefined") return null;
+  if (window.opener && !window.opener.closed) return window.opener as Window;
+  if (window.parent && window.parent !== window) return window.parent;
+  return null;
+}
+
+/* True when there is a PostMan to send to AND a window to send through. */
 export function canSendToPostman(): boolean {
-  if (typeof window === "undefined") return false;
-  return !!getHandoff() && !!window.opener && !window.opener.closed;
+  return !!getHandoff() && !!postmanWindow();
 }
 
 /* Hand the workbook over. `workbookBase64` is exactly what this app's own
@@ -106,11 +117,10 @@ export function sendToPostman(
 ): { ok: boolean; reason?: string } {
   const h = getHandoff();
   if (!h) return { ok: false, reason: "This app was not opened from PostMan." };
-  if (typeof window === "undefined" || !window.opener || window.opener.closed) {
-    return { ok: false, reason: "The PostMan window has been closed." };
-  }
+  const target = postmanWindow();
+  if (!target) return { ok: false, reason: "The PostMan window has been closed." };
   try {
-    window.opener.postMessage(
+    target.postMessage(
       { kind: "kisem-data", format, company, workbook: workbookBase64 },
       h.origin
     );
@@ -119,3 +129,13 @@ export function sendToPostman(
     return { ok: false, reason: (e as Error).message };
   }
 }
+
+/* Tell PostMan we actually rendered. Nothing cross-origin lets a parent
+   check that a frame it embedded is alive rather than showing the
+   browser's "refused to connect" page, so the app has to say so. Harmless
+   when opened in a window: PostMan ignores it. */
+export function greetPostman(): void {
+  const h = getHandoff();
+  const target = postmanWindow();
+  if (h && target) target.postMessage({ kind: "kisem-hello" }, h.origin);
+}
