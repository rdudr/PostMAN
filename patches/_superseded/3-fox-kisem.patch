+import * as FOX from "../lib/export-offline";
+
+const profile: any = {
+  id: "p1", companyName: "Shree Mahadev Silk Mills Pvt. Ltd.",
+  area: "GIDC Pandesara", district: "Surat", state: "Gujarat", pincode: "395023",
+  overallConsumption: 1850,
+};
+const now = new Date().toISOString();
+const zones: any[] = [
+  { id:"z1", name:"Main LT Panel", v1:415, v2:413, v3:414, uthd1:2.1, uthd2:2.3, uthd3:2.2,
+    i1:612, i2:598, i3:604, ithd1:6.8, ithd2:7.1, ithd3:6.9, pf:0.93,
+    measuredKva:432, measuredKw:402, totalPower:402, recordedBy:"R. Patel", createdAt:now },
+];
+const areas: any[] = [
+  { id:"a1", zoneId:"z1", name:"PCC-1 Dyeing", type:"PCC", v1:414, v2:413, v3:412,
+    i1:280, i2:274, i3:279, pf:0.91, measuredKva:196, measuredKw:178, totalPower:178,
+    recordedBy:"R. Patel", createdAt:now },
+  { id:"a2", zoneId:"z1", name:"MCC-2 Utilities", type:"MCC", v1:413, v2:412, v3:414,
+    i1:141, i2:138, i3:140, pf:0.88, measuredKva:99, measuredKw:87, totalPower:87,
+    recordedBy:"R. Patel", createdAt:now },
+];
+const entries: any[] = [
+  { id:"e1", areaId:"a1", machineTag:"JET-01 circulation pump", starterType:"DOL",
+    ratedKw:15, ratedHp:20, voltage:414, current:22.4, pf:0.86, measuredKw:13.8,
+    calculatedPower:13.8, loadFactor:92, entryType:"CLAMP", recordedBy:"R. Patel", createdAt:now,
+    createdById:"u1", description:"Running against a throttled valve." },
+  { id:"e2", areaId:"a2", machineTag:"Cooling tower fan 1", starterType:"VFD", vfdFrequency:42,
