# EASS API - copy to .env on the server and fill in. Never commit the real one.

# Where the data lives. Leave this BLANK: everything goes in one folder -
# "KISEM Project" on this machine's desktop - as one SQLite file plus the
# field apps' workbooks as files. That is one folder to back up and nothing
# to administer. Set it only if the team outgrows that and moves to
# PostgreSQL (postgresql://user:pass@host/db).
DATABASE_URL=

# The folder itself, if it should not be "KISEM Project" on the desktop.
# It is created on first start, with uploads\, backups\ and logs\ inside.
DATA_DIR=

# Signs every session token. 64 random characters; changing it signs everyone
# out, which is also how you sign everyone out.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# How long a sign-in lasts.
TOKEN_HOURS=12

# The browsers allowed to call this API, comma separated. Anything not listed
# is refused by the browser itself.
ALLOWED_ORIGINS=https://post-man-iota.vercel.app,https://post-man-rdudrs-projects.vercel.app

# The first account, created once on first start. Remove both lines after the
# first successful sign-in; an admin makes every other account from inside.
BOOTSTRAP_ADMIN_EMAIL=iea@iitgn.ac.in
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=IEA IIT Gandhinagar
