# EASS API - copy to .env on the server and fill in. Never commit the real one.

# Where the data lives. Leave this BLANK: everything goes in one folder -
# "KISEM Project" on this machine's desktop - as one SQLite file plus the
# field apps' workbooks as files. That is one folder to back up and nothing
# to administer. Set it only if the team outgrows that and moves to
# PostgreSQL (postgresql://user:pass@host/db).
DATABASE_URL=

# The folder itself, if it should not be "KISEM Project" on the desktop.
# It is created on first start, with uploads\, backups\ and logs\ inside.
DATA_DIR=

# Signs every session token. 64 random characters; changing it signs everyone
# out, which is also how you sign everyone out.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# How long a sign-in lasts.
TOKEN_HOURS=12

# The browsers allowed to call this API, comma separated. Anything not listed
# is refused by the browser itself - which shows up in PostMan as "Cannot
# reach the server" while curl works perfectly, so it is worth getting right.
#
# postman-ten-beta.vercel.app is THE address the team uses - the only one of
# the three that opens without a Vercel login. The other two are the same
# page under Vercel's team-scoped names, which sit behind Vercel SSO; they
# are listed so that a signed-in developer can use them too. Check all three
# against the project's domains if a deployment ever moves, because an
# address that no longer exists here locks the real page out of the API.
# The two local ones are a copy served from this machine while testing.
#
# NEVER widen this to every *.vercel.app - that is every preview deployment
# of every project on Vercel.
ALLOWED_ORIGINS=https://postman-ten-beta.vercel.app,https://postman-rdudrs-projects.vercel.app,https://postman-git-main-rdudrs-projects.vercel.app,http://127.0.0.1:4173,http://localhost:4173

# The first account, created once on first start. Remove both lines after the
# first successful sign-in; an admin makes every other account from inside.
BOOTSTRAP_ADMIN_EMAIL=iea@iitgn.ac.in
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=IEA IIT Gandhinagar
